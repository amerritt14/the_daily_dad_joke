<div class="joke-form-container">
  <div class="joke-form-wrapper">
    <div class="joke-form-header">
      <h1 class="joke-form-title">Edit Joke</h1>
    </div>

    <div class="joke-form-card">
      <%= form_with(model: joke, local: true) do |form| %>
        <% if joke.errors.any? %>
          <div class="joke-form-error-panel">
            <ul class="joke-form-error-list">
              <% joke.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <%= hidden_field_tag :redirect_status, params[:redirect_status] %>

        <div class="joke-form-group">
          <%= form.label :prompt, "Setup/Prompt", class: "joke-form-label" %>
          <%= form.text_area :prompt, class: "joke-form-textarea", rows: 3 %>
        </div>

        <div class="joke-form-group">
          <%= form.label :punchline, "Punchline", class: "joke-form-label" %>
          <%= form.text_area :punchline, class: "joke-form-textarea", rows: 3 %>
        </div>

        <div class="joke-form-group">
          <%= form.label :submitted_by, "Submitted By", class: "joke-form-label" %>
          <%= form.text_field :submitted_by, class: "joke-form-input", maxlength: 100 %>
        </div>

        <div class="joke-form-submit-group">
          <%= form.submit "Save", class: "joke-form-submit-button" %>
          <%= link_to "Cancel", jokes_path(status: params[:redirect_status]) %>
        </div>
      <% end %>
    </div>
  </div>
</div>
